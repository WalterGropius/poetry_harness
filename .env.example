# VERSO talks to models only through Vercel AI Gateway.
# Locally: create a key at https://vercel.com/ai-gateway and put it here (cp .env.example .env.local).
# On Vercel: leave it unset — the deployment's OIDC token authenticates the gateway automatically.
AI_GATEWAY_API_KEY=

# Optional model overrides (any AI Gateway model id).
# VERSO_POET_MODEL=anthropic/claude-opus-5.5
# VERSO_READER_MODEL=anthropic/claude-opus-5.5
# VERSO_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
# VERSO_JUDGE_MODEL=typesafe-ai/jev

# Force the offline twins (deterministic engine + library centos), even with a key.
# VERSO_OFFLINE=1
